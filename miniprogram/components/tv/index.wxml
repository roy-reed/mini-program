<view class="tv tv--{{phase}} {{disabled ? 'tv--disabled' : ''}}" bindtap="onTap">
  <view class="antenna antenna--left"></view>
  <view class="antenna antenna--right"></view>
  <view class="body">
    <view class="screen">
      <view class="screen-shape screen-shape--one"></view>
      <view class="screen-shape screen-shape--two"></view>
      <view class="scanline"></view>
      <view class="screen-label">{{label}}</view>
    </view>
    <view class="knob knob--large"></view>
    <view class="knob knob--small"></view>
  </view>
  <view class="base"></view>
</view>
