.tv { position: relative; width: 520rpx; height: 420rpx; transition: opacity 300ms ease, transform 300ms ease; animation: tv-float 2.4s ease-in-out infinite; }
.tv--zoom { animation: tv-zoom 300ms ease-in-out both; }
.tv--burst { animation: tv-burst 400ms ease-out both; }
.tv--disabled { opacity: 0.5; }
.antenna { position: absolute; top: 14rpx; width: 10rpx; height: 92rpx; border-radius: 10rpx; background: var(--sc-ink); transform-origin: bottom center; }
.antenna--left { left: 178rpx; transform: rotate(-28deg); }
.antenna--right { right: 178rpx; transform: rotate(28deg); }
.body { position: absolute; top: 76rpx; left: 30rpx; box-sizing: border-box; width: 460rpx; height: 292rpx; padding: 28rpx; border: 8rpx solid var(--sc-ink); border-radius: 42rpx; background: var(--sc-accent); box-shadow: 0 12rpx 0 var(--sc-ink); }
.screen { position: relative; width: 330rpx; height: 224rpx; overflow: hidden; border: 8rpx solid var(--sc-ink); border-radius: 28rpx; background: var(--sc-player-bg); }
.screen-shape { position: absolute; width: 260rpx; height: 220rpx; border-radius: 50%; filter: blur(8rpx); opacity: 0.85; animation: screen-flow 2.2s ease-in-out infinite alternate; }
.screen-shape--one { top: -86rpx; left: -54rpx; background: var(--sc-burst-1); }
.screen-shape--two { right: -72rpx; bottom: -92rpx; background: var(--sc-burst-3); animation-delay: -1.1s; }
.scanline { position: absolute; top: 0; left: 0; width: 100%; height: 8rpx; background: rgba(255, 255, 255, 0.45); animation: scan 1.8s linear infinite; }
.screen-label { position: absolute; top: 50%; left: 0; width: 100%; color: var(--sc-accent-ink); font-size: var(--sc-font-body); font-weight: 600; text-align: center; text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.4); transform: translateY(-50%); }
.knob { position: absolute; right: 18rpx; border: 6rpx solid var(--sc-ink); border-radius: 50%; background: var(--sc-paper); }
.knob--large { top: 74rpx; width: 42rpx; height: 42rpx; }
.knob--small { top: 142rpx; width: 24rpx; height: 24rpx; }
.base { position: absolute; bottom: 24rpx; left: 78rpx; width: 364rpx; height: 30rpx; border-radius: 30rpx; background: var(--sc-ink); }
@keyframes tv-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10rpx); } }
@keyframes tv-zoom { 0% { transform: scale(1); } 65% { transform: scale(1.15) rotate(1deg); } 100% { transform: scale(1.15) rotate(-1deg); } }
@keyframes tv-burst { 0% { opacity: 1; transform: scale(1.15); } 100% { opacity: 0; transform: scale(1.6); } }
@keyframes screen-flow { from { transform: translate(0, 0) scale(1); } to { transform: translate(50rpx, -24rpx) scale(1.2); } }
@keyframes scan { from { transform: translateY(0); } to { transform: translateY(216rpx); } }
