<view class="page draw-page">
  <image class="memory-scene" src="/assets/memory-park.svg" mode="aspectFill"></image>
  <view class="draw-content">
    <view class="draw-title">{{copy.draw.title}}</view>
    <view class="draw-stage">
      <view class="stage-halo"></view>
      <tv phase="{{phase}}" label="{{copy.draw.button}}" disabled="{{disabled}}" bind:draw="onDraw" />
    </view>
    <view class="draw-rule" bindtap="onRules">{{copy.draw.rules}}</view>
  </view>
  <burst active="{{phase === 'burst'}}" duration-ms="{{burstMs}}" />
</view>
