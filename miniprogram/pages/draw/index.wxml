<view class="page draw-page">
  <view class="draw-title">{{copy.draw.title}}</view>
  <tv phase="{{phase}}" label="{{copy.draw.button}}" disabled="{{disabled}}" bind:draw="onDraw" />
  <view class="link rules-link" bindtap="onRules">{{copy.draw.rules}}</view>
  <burst active="{{phase === 'burst'}}" duration-ms="{{burstMs}}" />
</view>
