.draw-page { display: flex; flex-direction: column; align-items: center; text-align: center; background: linear-gradient(180deg, var(--sc-paper-white), var(--sc-bg)); }
.draw-title { margin: 36rpx 0 24rpx; color: var(--sc-ink); font-size: var(--sc-font-title); font-weight: 600; line-height: 1.3; }
.rules-link { margin-top: 28rpx; font-size: var(--sc-font-small); }
.choose-entry { box-sizing: border-box; width: 100%; max-width: 600rpx; margin-top: 30rpx; padding: 24rpx 32rpx; border: 3rpx solid var(--sc-deep-teal); border-radius: 24rpx; background: var(--sc-mint); color: var(--sc-deep-teal); font-size: var(--sc-font-body); font-weight: 600; box-shadow: 0 7rpx 0 rgba(56, 92, 96, 0.13); }
.choice-heading { width: 100%; margin: 0 0 32rpx; text-align: left; }
.choice-title { font-size: 46rpx; font-weight: 700; color: var(--sc-deep-teal); letter-spacing: 1rpx; }
.choice-subtitle { margin-top: 14rpx; color: var(--sc-ink-2); font-size: 25rpx; line-height: 1.55; }
.choice-section-title { box-sizing: border-box; width: 100%; margin-bottom: 20rpx; padding-left: 18rpx; border-left: 7rpx solid var(--sc-peach); color: var(--sc-deep-teal); font-size: 31rpx; font-weight: 600; text-align: left; }
.background-grid { display: flex; flex-wrap: wrap; justify-content: space-between; width: 100%; row-gap: 20rpx; }
.background-card { box-sizing: border-box; width: 48%; padding: 9rpx 9rpx 14rpx; border: 3rpx solid transparent; border-radius: 18rpx; background: var(--sc-paper); box-shadow: 0 6rpx 20rpx rgba(56, 92, 96, 0.10); }
.background-card--selected { border-color: var(--sc-deep-teal); background: var(--sc-sky); }
.poster-wrap { position: relative; overflow: hidden; width: 100%; height: 310rpx; border-radius: 11rpx; background: var(--sc-cream); }
.poster { display: block; width: 100%; height: 100%; }
.poster-placeholder { width: 100%; height: 100%; background: linear-gradient(145deg, var(--sc-sky), var(--sc-cream)); }
.selected-mark { position: absolute; top: 10rpx; right: 10rpx; display: flex; align-items: center; justify-content: center; width: 43rpx; height: 43rpx; border-radius: 50%; background: var(--sc-deep-teal); color: var(--sc-paper); font-size: 28rpx; font-weight: 700; }
.background-label { padding-top: 14rpx; color: var(--sc-deep-teal); font-size: 27rpx; font-weight: 600; }
.poster-tip { margin-top: 12rpx; color: var(--sc-ink-2); font-size: 22rpx; }
.music-title { margin-top: 40rpx; }
.track-grid { display: flex; flex-wrap: wrap; justify-content: space-between; width: 100%; row-gap: 18rpx; }
.track-card { box-sizing: border-box; display: flex; align-items: center; gap: 12rpx; width: 48%; min-height: 83rpx; padding: 14rpx 20rpx; border: 3rpx solid var(--sc-line); border-radius: 20rpx; background: var(--sc-paper); color: var(--sc-ink); font-size: 27rpx; }
.track-card--selected { border-color: var(--sc-deep-teal); background: var(--sc-mint); color: var(--sc-deep-teal); font-weight: 600; }
.track-dot { width: 16rpx; height: 16rpx; border: 3rpx solid var(--sc-deep-teal); border-radius: 50%; }
.track-card--selected .track-dot { background: var(--sc-deep-teal); }
.choice-confirm { box-sizing: border-box; width: 100%; margin-top: 44rpx; padding: 7rpx 20rpx; border: none; border-radius: 24rpx; background: var(--sc-deep-teal); color: var(--sc-paper); font-size: 30rpx; font-weight: 600; }
.choice-confirm::after { border: none; }
.choice-random { box-sizing: border-box; width: 100%; margin-top: 18rpx; padding: 6rpx 20rpx; border: 3rpx solid var(--sc-deep-teal); border-radius: 24rpx; background: var(--sc-paper); color: var(--sc-deep-teal); font-size: 29rpx; font-weight: 600; }
.choice-random::after { border: none; }
.choice-back { margin: 30rpx 0 4rpx; color: var(--sc-deep-teal); font-size: 27rpx; text-decoration: underline; }
