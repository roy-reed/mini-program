.page.invitation-page {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  min-height: 100vh;
  height: auto;
  flex-direction: column;
  align-items: center;
  overflow: visible;
  padding: 12px 16px calc(24px + env(safe-area-inset-bottom));
}
.header { width: 100%; margin-bottom: 12px; text-align: center; flex: 0 0 auto; }
.album { display: block; color: var(--sc-ink); font-size: 18px; font-weight: 600; line-height: 1.35; }
.release { display: block; margin-top: 4px; color: var(--sc-ink-2); font-size: 14px; line-height: 1.4; }
.player { position: relative; flex: 0 0 auto; overflow: hidden; max-width: 100%; border-radius: 16px; background: linear-gradient(145deg, var(--sc-sky), var(--sc-cream)); }
.video { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.name { position: absolute; z-index: 2; left: 0; width: 100%; line-height: 1.2; text-align: center; text-shadow: 0 2px 8px rgba(0, 0, 0, 0.35); white-space: nowrap; transition: opacity 250ms linear; }
.media-cover { position: absolute; z-index: 5; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(145deg, var(--sc-sky), var(--sc-cream)); }
.media-cover-photo { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.media-cover-wash { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(245, 240, 223, 0.13); }
.media-cover-card { position: absolute; top: 50%; left: 8%; box-sizing: border-box; width: 84%; padding: 16px 12px; border: 1px solid rgba(56, 92, 96, 0.18); border-radius: 14px; background: rgba(245, 240, 223, 0.95); color: var(--sc-deep-teal); text-align: center; transform: translateY(-50%); }
.media-cover-tag { font-size: 11px; letter-spacing: 2px; opacity: 0.72; }
.media-cover-title { margin-top: 8px; font-size: 16px; font-weight: 600; line-height: 1.5; }
.media-cover-caption { margin-top: 8px; color: var(--sc-ink-2); font-size: 13px; line-height: 1.5; }
.media-cover-action { margin: 14px 16px 0; padding: 12px 10px; border-radius: 12px; background: var(--sc-deep-teal); color: var(--sc-paper); font-size: 14px; font-weight: 600; line-height: 1.35; }
.media-cover-other { margin-top: 10px; padding: 6px; color: var(--sc-deep-teal); font-size: 12px; text-decoration: underline; }
.media-buffer-note { position: absolute; z-index: 4; top: 12px; left: 10%; box-sizing: border-box; width: 80%; padding: 8px 10px; border-radius: 10px; background: rgba(56, 92, 96, 0.88); color: var(--sc-paper); font-size: 12px; text-align: center; }
.ai { flex: 0 0 auto; margin-top: 10px; color: var(--sc-ink-2); font-size: 13px; line-height: 1.4; text-align: center; }
.links { display: flex; flex: 0 0 auto; flex-wrap: wrap; justify-content: center; align-items: center; gap: 8px; margin-top: 14px; font-size: 14px; line-height: 1.4; }
.sep { color: var(--sc-ink-2); }
.button-hover { opacity: 0.78; }
