.invitation-page { display: flex; flex-direction: column; align-items: center; padding-top: 24rpx; }
.header { width: 100%; margin-bottom: 24rpx; text-align: center; }
.album { display: block; color: var(--sc-ink); font-size: var(--sc-font-body); font-weight: 600; }
.release { display: block; margin-top: 6rpx; color: var(--sc-ink-2); font-size: var(--sc-font-small); }
.player { position: relative; overflow: hidden; border-radius: var(--sc-radius); background: var(--sc-sky); }
.video { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.name { position: absolute; z-index: 2; left: 0; width: 100%; line-height: 1.2; text-align: center; text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.35); white-space: nowrap; transition: opacity 250ms linear; }
.media-cover { position: absolute; z-index: 5; top: 0; left: 0; width: 100%; height: 100%; background: var(--sc-sky); }
.media-cover-photo { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.media-cover-wash { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(245, 240, 223, 0.13); }
.media-cover-card { position: absolute; top: 39%; left: 8%; box-sizing: border-box; width: 84%; padding: 26rpx 18rpx 24rpx; border: 2rpx solid rgba(56, 92, 96, 0.18); border-radius: 22rpx; background: rgba(245, 240, 223, 0.95); color: var(--sc-deep-teal); text-align: center; }
.media-cover-tag { font-size: 21rpx; letter-spacing: 3rpx; opacity: 0.72; }
.media-cover-title { margin-top: 13rpx; font-size: 29rpx; font-weight: 600; line-height: 1.5; }
.media-cover-caption { margin-top: 14rpx; font-size: 23rpx; line-height: 1.5; color: var(--sc-ink-2); }
.media-cover-action { margin: 24rpx 26rpx 0; padding: 18rpx 10rpx; border-radius: 16rpx; background: var(--sc-deep-teal); color: var(--sc-paper); font-size: 27rpx; font-weight: 600; }
.media-cover-other { margin-top: 19rpx; padding: 8rpx; color: var(--sc-deep-teal); font-size: 24rpx; text-decoration: underline; }
.media-buffer-note { position: absolute; z-index: 4; top: 26rpx; left: 10%; box-sizing: border-box; width: 80%; padding: 12rpx; border-radius: 16rpx; background: rgba(56, 92, 96, 0.88); color: var(--sc-paper); font-size: 23rpx; text-align: center; }
.ai { margin-top: 20rpx; color: var(--sc-ink-2); font-size: var(--sc-font-small); }
.links { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 14rpx; margin-top: 28rpx; font-size: var(--sc-font-small); }
.sep { color: var(--sc-ink-2); }
.button-hover { opacity: 0.78; }
