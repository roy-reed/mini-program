.hero {
  padding: 72rpx 0 96rpx;
  text-align: center;
}

.title {
  color: var(--sc-ink);
  font-size: var(--sc-font-title);
  font-weight: 600;
  line-height: 1.3;
}

.subtitle,
.hint {
  color: var(--sc-ink-2);
  font-size: var(--sc-font-small);
  line-height: 1.6;
}

.agree {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 32rpx;
  font-size: var(--sc-font-small);
}

.checkbox {
  box-sizing: border-box;
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid var(--sc-line);
  border-radius: 8rpx;
  background: var(--sc-paper);
}

.checkbox--on {
  border-color: var(--sc-accent);
  background: var(--sc-accent);
}

.input {
  box-sizing: border-box;
  width: 100%;
  height: 96rpx;
  margin: 32rpx 0 16rpx;
  padding: 0 28rpx;
  border: 2rpx solid var(--sc-line);
  border-radius: var(--sc-radius);
  background: var(--sc-paper);
}

.hint {
  margin-bottom: 24rpx;
}

.button-hover { opacity: 0.78; }
