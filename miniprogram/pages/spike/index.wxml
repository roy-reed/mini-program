<view class="page">
  <view class="title">Playback Spike</view>
  <view wx:if="{{ready}}" class="combo">Combo: {{comboKey}}</view>
  <view class="player">
    <video
      id="spike-video"
      wx:if="{{ready}}"
      class="video"
      src="{{videoUrl}}"
      poster="{{posterUrl}}"
      loop
      controls="{{false}}"
      show-center-play-btn="{{false}}"
      show-play-btn="{{false}}"
      show-fullscreen-btn="{{false}}"
      show-progress="{{false}}"
      enable-progress-gesture="{{false}}"
      object-fit="cover"
      bindplay="onPlay"
      bindpause="onPause"
      bindwaiting="onWaiting"
      binderror="onError"
      bindended="onEnded"
      bindtimeupdate="onTimeUpdate"
    ></video>
    <view wx:if="{{ready}}" class="overlay" style="opacity: {{opacity}}">Name Overlay</view>
  </view>
  <view class="controls">
    <button size="mini" bindtap="onPlayButton">Play</button>
    <button size="mini" bindtap="onPauseButton">Pause</button>
    <button size="mini" bindtap="onStopButton">Stop</button>
    <button size="mini" bindtap="onToggleMute">Toggle obeyMuteSwitch</button>
  </view>
  <view class="info">
    <view>currentTime: {{currentTime}}s</view>
    <view>phase: {{phase}}</view>
    <view>opacity: {{opacity}}</view>
    <view>loops: {{loopCount}}</view>
    <view>obeyMuteSwitch: {{obeyMuteSwitch}}</view>
  </view>
  <view class="events-title">Events</view>
  <view wx:for="{{events}}" wx:key="*this" class="event">{{item}}</view>
</view>
