.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  color: var(--sc-ink);
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.combo,
.info,
.events-title,
.event {
  font-size: 24rpx;
  line-height: 1.6;
}

.player {
  position: relative;
  width: 600rpx;
  height: 800rpx;
  max-width: 100%;
  margin: 24rpx auto;
  overflow: hidden;
  background: var(--sc-player-bg);
}

.video {
  width: 600rpx;
  height: 800rpx;
}

.overlay {
  position: absolute;
  top: 70%;
  left: 0;
  width: 100%;
  color: #FFFFFF;
  font-size: 44rpx;
  line-height: 1.2;
  text-align: center;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.35);
  pointer-events: none;
  transform: translateY(-50%);
  transition: opacity 250ms linear;
}

.controls {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.events-title {
  margin-top: 20rpx;
  font-weight: 600;
}

.event {
  color: var(--sc-ink-2);
}
